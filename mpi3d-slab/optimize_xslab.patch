+        for(std::uint64_t b=0;b<nb;++b)u64(0);
+        std::vector<T> buffer(static_cast<std::size_t>(block_bytes/sizeof(T)));
+        std::vector<unsigned char> packed(static_cast<std::size_t>(compressBound(block_bytes)));
+        std::size_t used=0,block=0;
+        auto flush=[&]{
+            if(!used)return;
+            auto* bytes=reinterpret_cast<unsigned char*>(buffer.data());
+            if(!little_endian())for(std::size_t q=0;q<used;++q)
+                std::reverse(bytes+q*sizeof(T),bytes+(q+1)*sizeof(T));
+            uLongf dest=static_cast<uLongf>(packed.size());
+            const int rc=compress2(packed.data(),&dest,bytes,static_cast<uLong>(used*sizeof(T)),c.compression_level);
