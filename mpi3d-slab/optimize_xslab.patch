+            sizes.at(block++)=dest;
+            f.write(reinterpret_cast<const char*>(packed.data()),static_cast<std::streamsize>(dest));check();
+            used=0;
+        };
+        for(int k=1;k<=c.nz;++k)for(int j=1;j<=c.ny;++j)for(int i=1;i<=c.nx;++i){
