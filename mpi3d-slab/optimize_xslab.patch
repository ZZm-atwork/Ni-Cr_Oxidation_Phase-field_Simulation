+// Sorted, disjoint intervals covering a periodic neighborhood. Full coverage
+// visits an axis only once, even if the exclusion radius exceeds its period.
+struct AxisNeighborhood { int count=0; std::array<int,2> lo{},hi{}; };
+static int bounded_reach(double radius,int n){return radius>=n?n:int(std::ceil(radius));}
+static AxisNeighborhood periodic_neighborhood(int center,double radius,int n){
+    const int r=bounded_reach(radius,n);
+    AxisNeighborhood a;
+    if(2LL*r+1>=n){a.count=1;a.lo[0]=1;a.hi[0]=n;return a;}
+    const long long lo=static_cast<long long>(center)-r,hi=static_cast<long long>(center)+r;
+    if(lo<1){a.count=2;a.lo={1,int(lo+n)};a.hi={int(hi),n};}
+    else if(hi>n){a.count=2;a.lo={1,int(lo)};a.hi={int(hi-n),n};}
+    else{a.count=1;a.lo[0]=int(lo);a.hi[0]=int(hi);}
+    return a;
+}
