+             <<"  <Piece Extent=\"0 "<<c.nx-1<<" 0 "<<c.ny-1<<" 0 "<<c.nz-1<<"\">\n"
+             <<"   <PointData Scalars=\"phi\">\n";
+            for(std::size_t a=0;a<names.size();++a){
+                f<<"    <DataArray type=\""<<(c.output_precision=="float64"?"Float64":"Float32")
+                 <<"\" Name=\""<<names[a]<<"\" NumberOfComponents=\"1\" format=\"appended\" offset=\"";
+                offset_positions[a]=f.tellp();f<<"00000000000000000000\"/>\n";
+            }
+            f<<"   </PointData>\n   <CellData/>\n  </Piece>\n </ImageData>\n <AppendedData encoding=\"raw\">\n_";
+            appended_start=f.tellp();check();
+        }catch(...){f.close();std::error_code ec;fs::remove(temp_path,ec);throw;}
+    }
+    CompressedVtiWriter(const CompressedVtiWriter&)=delete;
+    CompressedVtiWriter& operator=(const CompressedVtiWriter&)=delete;
+    ~CompressedVtiWriter(){if(!committed){f.close();std::error_code ec;fs::remove(temp_path,ec);}}
+    template<class Fn> void array(Fn value){
+        if(next>=names.size())throw std::runtime_error("Too many VTI arrays.");
+        const auto start=f.tellp();
+        const auto offset=static_cast<std::uint64_t>(start-appended_start);
+        f.seekp(offset_positions[next]);f<<std::setw(20)<<std::setfill('0')<<offset<<std::setfill(' ');
+        f.seekp(start);check();
+        if(c.output_precision=="float64")write_array<double>(value);else write_array<float>(value);
+        ++next;
+    }
+    void finish(){
+        if(next!=names.size())throw std::runtime_error("Missing VTI arrays.");
+        f<<"\n </AppendedData>\n</VTKFile>\n";f.flush();check();f.close();check();
+        fs::rename(temp_path,final_path);committed=true;
+    }
