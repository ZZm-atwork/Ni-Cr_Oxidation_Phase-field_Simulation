+    template<class T,class Fn> void write_array(Fn value){
+        static_assert(std::numeric_limits<T>::is_iec559,"VTI requires IEEE floating point.");
+        const std::uint64_t n=std::uint64_t(c.nx)*c.ny*c.nz,total=n*sizeof(T);
