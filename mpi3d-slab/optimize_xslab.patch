+            if(std::isfinite(v) && std::abs(v)>std::numeric_limits<T>::max())
+                throw std::runtime_error(std::string("VTI ")+names[next]+" exceeds output type range; use --output-precision float64.");
+            // Small values may round to zero in Float32; no change to solver state.
+            buffer[used++]=static_cast<T>(v);
+            if(used==buffer.size())flush();
+        }
+        flush();
+        if(block!=sizes.size())throw std::runtime_error("Internal VTI block-count mismatch.");
+        const auto end=f.tellp();
+        f.seekp(header_start+std::streamoff(24));for(auto size:sizes)u64(size);
+        f.seekp(end);check();
+    }
+public:
+    CompressedVtiWriter(const std::string& path,const Config& cfg):c(cfg),final_path(path),temp_path(path+".tmp"){
+        static_assert(sizeof(float)==4 && sizeof(double)==8,"VTI output requires Float32/Float64.");
+        try{
+            f.open(temp_path,std::ios::binary|std::ios::trunc);
+            if(!f)throw std::runtime_error("Cannot open "+temp_path);
+            f.imbue(std::locale::classic());
+            f<<std::setprecision(17)<<"<?xml version=\"1.0\"?>\n"
+             <<"<VTKFile type=\"ImageData\" version=\"1.0\" byte_order=\"LittleEndian\" header_type=\"UInt64\" compressor=\"vtkZLibDataCompressor\">\n"
+             <<" <ImageData WholeExtent=\"0 "<<c.nx-1<<" 0 "<<c.ny-1<<" 0 "<<c.nz-1
+             <<"\" Origin=\""<<.5*c.dx<<" "<<.5*c.dy<<" "<<.5*c.dz
